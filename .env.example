# Copy to `.env` and fill in values. `.env` is gitignored — never commit secrets.
# `config.py` loads this file via python-dotenv when the app starts (install: pip install python-dotenv).
#
# If these values ever appeared in the repository, treat them as compromised:
# rotate Telestaff passwords, refresh session cookies, change admin password,
# and request a new Active911 device pairing as your org requires.

# Required when DASHBOARD_DEBUG is false (production).
SECRET_KEY="This is a secret key for the dashboard"

# true = debug server, ephemeral SECRET_KEY allowed if SECRET_KEY unset
DASHBOARD_DEBUG=true

# Bind address/port for local `python afddashboard.py` (not Docker; see README Docker).
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# --- Docker Compose (substitution in docker-compose.yml; also see env_file on the service) ---
# Published host port -> container 5000. Inside the container, Gunicorn always uses 5000.
HOST_PORT=8000

# Optional: tag/name for `docker compose build` / `image:` (default below).
# COMPOSE_IMAGE=afd-dashboard:local

# Optional: Compose restart policy (no | always | on-failure | unless-stopped).
# DOCKER_RESTART=unless-stopped

# Required when DASHBOARD_DEBUG is false
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required to run afddashboard.py (Active911 thread)
ACTIVE_911_DEVICE_ID=

# Telestaff roster integration — all required for /roster to work
TS_SERVER=
TS_DOMAIN=
TS_USER=
TS_PASS=
TS_COOKIE=

# Mapbox public access token for station alert modal map (https://account.mapbox.com/access-tokens/)
# If unset, the map uses OpenStreetMap tiles instead.
MAPBOX_ACCESS_TOKEN=

# Optional
# DATABASE_URL — local dev: sqlite:///path/to/app.db | Docker: sqlite:////data/app.db (compose default) or Postgres URL
# ASYNC_MODE=threading
# LOGGING_PATH=log
# LOGGING_LEVEL=20   # INFO; default in code is 1 if unset
# GUNICORN_THREADS=20   # gthread worker pool (Docker / production)
